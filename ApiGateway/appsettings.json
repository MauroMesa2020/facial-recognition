
{
  "ReverseProxy": {
    "Routes": {
      "person-route": {
        "ClusterId": "person-service",
        "Match": {
          "Path": "/api/person/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "person-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5196/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
